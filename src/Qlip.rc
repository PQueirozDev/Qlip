#include <winres.h>
#include "resource.h"

// Ícone do aplicativo (exe, janelas e bandeja).
IDI_QCLIP ICON "../assets/icons/qlip.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "FileDescription", "Qlip - gravador de tela e clipes"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "Qlip"
            VALUE "OriginalFilename", "Qlip.exe"
            VALUE "ProductName", "Qlip"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
